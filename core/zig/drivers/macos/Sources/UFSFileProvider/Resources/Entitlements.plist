<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- FileProvider Extension -->
    <key>com.apple.developer.fileprovider.extensions</key>
    <array>
        <string>com.ufs.fileprovider</string>
    </array>

    <!-- FileProvider Testing Mode (for development) -->
    <key>com.apple.developer.fileprovider.testing-mode</key>
    <true/>

    <!-- System Extension (for kernel extension) -->
    <key>com.apple.developer.system-extension.install</key>
    <true/>

    <!-- Kernel Extension (FSKit) -->
    <key>com.apple.developer.kernel.access</key>
    <true/>
    <key>com.apple.developer.kernel.extension</key>
    <true/>

    <!-- Hardware access for block devices -->
    <key>com.apple.security.device.block</key>
    <true/>

    <!-- File system access -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Network access for XPC communication -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow debugging -->
    <key>com.apple.security.get-task-allow</key>
    <true/>

    <!-- Team ID (replace with actual) -->
    <key>com.apple.developer.team-identifier</key>
    <string>$(TEAM_ID)</string>
</dict>
</plist>